{
  "name": "cores3-debug-monitor",
  "version": "0.1.0",
  "description": "Lightweight Network Diagnostics for M5Stack CoreS3",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "preview": "vite preview web",
    "start": "node server/index.js",
    "simulate": "node tools/device-simulator.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "esp32",
    "m5stack",
    "cores3",
    "debugger",
    "diagnostics",
    "ndjson",
    "websocket"
  ],
  "author": "CoreS3-DebugMonitor Contributors",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "vite": "^6.0.0"
  }
}
